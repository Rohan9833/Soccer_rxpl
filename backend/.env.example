# --- Server ---
NODE_ENV=development
PORT=5000

# --- Security ---
# Comma-separated list of origins allowed to call the API (your microsite domain(s)).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Set to 1 (or the number of proxy hops) when running behind Nginx / a load balancer,
# so rate limiting sees the real client IP. Keep "false" otherwise.
TRUST_PROXY=false
# Demo requests allowed per IP per window.
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=5

# --- Optional single-service deployment ---
# When true, Express also serves the built frontend (frontend/dist).
SERVE_FRONTEND=false
FRONTEND_DIST=../frontend/dist

# --- SMTP email (Request a Demo) ---
EMAIL_FROM="RXPL <edetailer@digilateral.com>"
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=edetailer@digilateral.com
EMAIL_PASS=your_smtp_password
# Inbox that receives demo requests
EMAIL_TO=info@digilateral.com
